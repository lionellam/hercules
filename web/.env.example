# Copy to .env.local for local development. Set the same values in Vercel's project settings.

# Postgres connection. Local: the PGlite server from `npm run db:local`. Production: Neon's pooled connection string.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# Auth.js session encryption key. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Anthropic API key. Leave empty locally to use the keyword stand-in parser.
ANTHROPIC_API_KEY=

# Local only: shows a "Dev sign in" form so the app can be tested without Google. Ignored in production.
DEV_LOGIN=true
